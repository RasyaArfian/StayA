    <!-- JavaScript Application Logic -->
    <script>
        // Current Customizer State (Defaults matching the Figma Prototype in PDF)
        let currentRecipe = {
            bean: 'Arabica',
            milk: 'Oat Milk',
            sugar: '50% Sugar',
            flavor: 'Caramel',
            basePrice: 25000,
            milkExtra: 5000
        };

        // Initial Saved Recipes in Database
        let savedRecipes = [
            {
                id: 1,
                name: "STAYa Focus Signature",
                bean: "Arabica",
                milk: "Oat Milk",
                sugar: "50% Sugar",
                flavor: "Caramel",
                price: 30000
            },
            {
                id: 2,
                name: "Begadang Revisi Booster",
                bean: "Robusta",
                milk: "Full Cream",
                sugar: "100% Sugar",
                flavor: "Hazelnut",
                price: 25000
            }
        ];

        // Initialize Icons and UI on Load
        window.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            updateCustomizerUI();
            renderSavedRecipes();

            // Mobile menu toggle
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenu = document.getElementById('mobileMenu');
            if (mobileMenuBtn) {
                mobileMenuBtn.addEventListener('click', () => {
                    mobileMenu.classList.toggle('hidden');
                });
            }
        });

        // Toast Notification Helper (Replaces alert)
        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-espresso-900 border-caramel-500 text-cream-50' : 'bg-caramel-600 border-white text-white';
            
            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3.5 rounded-2xl shadow-xl border-l-4 ${bgClass} text-xs sm:text-sm font-bold transition-all duration-300`;
            toast.innerHTML = `
                <span>☕</span>
                <span class="flex-1">${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Handle Option Selection in Simulator
        function selectOption(category, value, extraCost) {
            currentRecipe[category] = value;
            if (category === 'milk') {
                currentRecipe.milkExtra = extraCost;
            }
            updateCustomizerUI();
        }

        // Preset Mode Button
        function applyPresetRecipe(mode) {
            if (mode === 'focus') {
                currentRecipe.bean = 'Robusta';
                currentRecipe.milk = 'Oat Milk';
                currentRecipe.sugar = '0% Sugar';
                currentRecipe.flavor = 'Hazelnut';
                currentRecipe.milkExtra = 5000;
                document.getElementById('recipeCustomName').value = 'Deep Work Focus Mode';
                updateCustomizerUI();
                showToast('Preset "Focus Mode" diterapkan: Robusta + Oat Milk + 0% Sugar!');
            }
        }

        // Update Customizer Buttons, Price, Summary & Visual Cup
        function updateCustomizerUI() {
            const totalPrice = currentRecipe.basePrice + currentRecipe.milkExtra;
            const formattedPrice = 'Rp ' + totalPrice.toLocaleString('id-ID');

            // Update Text Summary & Price Badges
            const summaryStr = `${currentRecipe.bean} • ${currentRecipe.milk} • ${currentRecipe.sugar} • ${currentRecipe.flavor}`;
            document.getElementById('signatureSummaryText').textContent = summaryStr;
            document.getElementById('topPriceBadge').textContent = formattedPrice;
            document.getElementById('bottomTotalPrice').textContent = `Total: ${formattedPrice}`;

            // Highlight Selected Buttons
            const groups = {
                bean: ['Arabica', 'Robusta'],
                milk: ['Full Cream', 'Oat Milk'],
                sugar: ['100% Sugar', '50% Sugar', '0% Sugar'],
                flavor: ['Vanilla', 'Caramel', 'Hazelnut']
            };

            Object.keys(groups).forEach(group => {
                groups[group].forEach(optionVal => {
                    const btn = document.getElementById(`${group}-${optionVal}`);
                    if (!btn) return;
                    if (currentRecipe[group] === optionVal) {
                        btn.className = 'option-btn p-3.5 sm:p-4 rounded-2xl border-2 text-left transition-all bg-espresso-800 text-cream-50 border-espresso-800 shadow-sm';
                        if (group === 'sugar' || group === 'flavor') {
                            btn.classList.replace('text-left', 'text-center');
                        }
                    } else {
                        btn.className = 'option-btn p-3.5 sm:p-4 rounded-2xl border-2 text-left transition-all bg-cream-100 text-espresso-900 border-cream-300 hover:border-espresso-700';
                        if (group === 'sugar' || group === 'flavor') {
                            btn.classList.replace('text-left', 'text-center');
                        }
                    }
                });
            });

            // Update Cup Anatomy Visual Layers
            document.getElementById('cupLayerBean').textContent = currentRecipe.bean;
            document.getElementById('cupLayerMilk').textContent = currentRecipe.milk;
            document.getElementById('cupLayerSugar').textContent = currentRecipe.sugar;
            document.getElementById('cupLayerFlavor').textContent = currentRecipe.flavor;

            // Update Taste Profile Notes
            const bodyText = currentRecipe.bean === 'Arabica'
                ? 'Smooth & Fruity, Medium Caffeine (Fokus Santai)'
                : 'Bold & Strong, High Caffeine (Fokus Intens Anti Ngantuk)';
            document.getElementById('profileBodyText').textContent = bodyText;

            const calText = `${currentRecipe.milk} • ${currentRecipe.sugar} • Aroma ${currentRecipe.flavor}`;
            document.getElementById('profileCalorieText').textContent = calText;
        }

        // Save Current Recipe to Favorites List
        function saveCurrentRecipe() {
            const customNameInput = document.getElementById('recipeCustomName');
            const name = customNameInput.value.trim() || `Signature ${currentRecipe.bean} ${currentRecipe.flavor}`;
            const price = currentRecipe.basePrice + currentRecipe.milkExtra;

            const newRecipe = {
                id: Date.now(),
                name: name,
                bean: currentRecipe.bean,
                milk: currentRecipe.milk,
                sugar: currentRecipe.sugar,
                flavor: currentRecipe.flavor,
                price: price
            };

            savedRecipes.unshift(newRecipe);
            customNameInput.value = '';
            renderSavedRecipes();
            showToast(`Resep "${name}" berhasil disimpan ke Database Favorit!`);
        }

        // Render Saved Recipes List for 1-Click Reorder
        function renderSavedRecipes() {
            const listEl = document.getElementById('savedRecipesList');
            const badgeEl = document.getElementById('savedCountBadge');
            badgeEl.textContent = `${savedRecipes.length} Resep`;

            listEl.innerHTML = savedRecipes.map(item => `
                <div class="p-3.5 rounded-2xl bg-cream-100 border border-cream-300 flex items-center justify-between gap-3 hover:border-caramel-500 transition-all">
                    <div>
                        <h4 class="font-extrabold text-sm text-espresso-950">${item.name}</h4>
                        <p class="text-xs text-espresso-700">${item.bean} • ${item.milk} • ${item.sugar} • ${item.flavor}</p>
                        <span class="text-xs font-extrabold text-caramel-600">Rp ${item.price.toLocaleString('id-ID')}</span>
                    </div>
                    <button onclick="reorderSavedRecipe(${item.id})" class="px-3.5 py-2 rounded-xl bg-espresso-800 hover:bg-caramel-500 text-cream-50 text-xs font-bold shrink-0 transition-colors">
                        Pesan 1-Klik
                    </button>
                </div>
            `).join('');
        }

        // 1-Click Reorder Handler
        function reorderSavedRecipe(id) {
            const found = savedRecipes.find(r => r.id === id);
            if (!found) return;
            currentRecipe.bean = found.bean;
            currentRecipe.milk = found.milk;
            currentRecipe.sugar = found.sugar;
            currentRecipe.flavor = found.flavor;
            currentRecipe.milkExtra = found.milk === 'Oat Milk' ? 5000 : 0;
            document.getElementById('recipeCustomName').value = found.name;
            updateCustomizerUI();
            showToast(`Racikan "${found.name}" dimuat! Siap dipesan tanpa antre.`);
        }

        // Open Checkout Modal
        function openCheckoutModal() {
            const totalPrice = currentRecipe.basePrice + currentRecipe.milkExtra;
            const customName = document.getElementById('recipeCustomName').value.trim() || 'STAYa Your Signature';
            const modal = document.getElementById('customModal');
            const content = document.getElementById('modalContent');

            content.innerHTML = `
                <div class="text-center space-y-4">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-500/15 text-emerald-700 flex items-center justify-center mx-auto text-2xl font-bold">
                        ✓
                    </div>
                    <span class="px-3 py-1 rounded-full bg-caramel-500/15 text-caramel-600 text-xs font-extrabold uppercase">Pesanan QR Meja #08 Siap</span>
                    <h3 class="text-2xl font-extrabold text-espresso-950">${customName}</h3>
                    <div class="bg-cream-100 p-4 rounded-2xl border border-cream-300 text-left text-xs space-y-1.5">
                        <div class="flex justify-between"><span>Biji Kopi:</span><strong>${currentRecipe.bean}</strong></div>
                        <div class="flex justify-between"><span>Pilihan Susu:</span><strong>${currentRecipe.milk}</strong></div>
                        <div class="flex justify-between"><span>Takaran Gula:</span><strong>${currentRecipe.sugar}</strong></div>
                        <div class="flex justify-between"><span>Aroma Tambahan:</span><strong>${currentRecipe.flavor}</strong></div>
                        <div class="border-t border-cream-300 pt-2 mt-2 flex justify-between text-sm font-extrabold text-espresso-950">
                            <span>Total Pembayaran (QRIS):</span>
                            <span class="text-caramel-600">Rp ${totalPrice.toLocaleString('id-ID')}</span>
                        </div>
                    </div>
                    <p class="text-xs text-espresso-700">
                        Barista kami langsung meracik kopi Anda dan mengantarkannya ke meja fokus Anda tanpa perlu mengantre.
                    </p>
                    <button onclick="closeModal(); showToast('Pesanan diteruskan ke Barista STAYa!');" class="w-full py-3.5 rounded-xl bg-espresso-800 hover:bg-espresso-950 text-cream-50 font-extrabold text-sm">
                        Selesai & Konfirmasi Pesanan
                    </button>
                </div>
            `;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        // Switch Infographic Environment Mode (Noisy Cafe vs STAYa)
        function switchEnvironmentMode(mode) {
            const btnNoisy = document.getElementById('btnModeNoisy');
            const btnStaya = document.getElementById('btnModeStaya');
            const barNoise = document.getElementById('barNoise');
            const barFocus = document.getElementById('barFocus');
            const barEfficiency = document.getElementById('barEfficiency');

            const metricNoiseVal = document.getElementById('metricNoiseVal');
            const metricFocusVal = document.getElementById('metricFocusVal');
            const metricEfficiencyVal = document.getElementById('metricEfficiencyVal');

            if (mode === 'noisy') {
                btnNoisy.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-red-600 text-white shadow';
                btnStaya.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-espresso-900 text-cream-300';

                barNoise.style.width = '88%';
                barNoise.className = 'h-full bg-red-500 rounded-full transition-all duration-500';
                metricNoiseVal.textContent = '78 dB (Bising & Banyak Distraksi)';
                metricNoiseVal.className = 'text-red-400';

                barFocus.style.width = '27%';
                barFocus.className = 'h-full bg-red-500 rounded-full transition-all duration-500';
                metricFocusVal.textContent = '27% (Stres & Cepat Lelah Mental)';
                metricFocusVal.className = 'text-red-400';

                barEfficiency.style.width = '30%';
                barEfficiency.className = 'h-full bg-amber-500 rounded-full transition-all duration-500';
                metricEfficiencyVal.textContent = '30% (Antre Panjang & Minim Colokan)';
                metricEfficiencyVal.className = 'text-amber-400';
            } else {
                btnStaya.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-caramel-500 text-white shadow';
                btnNoisy.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all bg-red-500/20 text-red-300 border border-red-500/40';

                barNoise.style.width = '22%';
                barNoise.className = 'h-full bg-emerald-500 rounded-full transition-all duration-500';
                metricNoiseVal.textContent = '28 dB (Sangat Tenang / Kedap Suara)';
                metricNoiseVal.className = 'text-emerald-400';

                barFocus.style.width = '92%';
                barFocus.className = 'h-full bg-caramel-500 rounded-full transition-all duration-500';
                metricFocusVal.textContent = '92% (Optimal & Produktif)';
                metricFocusVal.className = 'text-caramel-400';

                barEfficiency.style.width = '98%';
                barEfficiency.className = 'h-full bg-emerald-500 rounded-full transition-all duration-500';
                metricEfficiencyVal.textContent = '98% (Scan QR Meja & Stopkontak Tiap Kursi)';
                metricEfficiencyVal.className = 'text-emerald-400';
            }
        }

        // Simulate Real-Time Outlet Status Refresh
        function refreshOutletStatus() {
            const crowds = ['Tenang (32% Terisi)', 'Tenang (35% Terisi)', 'Kondusif (40% Terisi)'];
            const seats = ['14 / 20 Kursi Kosong', '13 / 20 Kursi Kosong', '15 / 20 Kursi Kosong'];
            const randomIdx = Math.floor(Math.random() * crowds.length);

            document.getElementById('liveCrowdText').textContent = crowds[randomIdx];
            document.getElementById('liveSeatText').textContent = seats[randomIdx];
            showToast('Status Real-Time Outlet STAYa diperbarui!');
        }

        // Handle Reservation Form Submission
        function handleReservationSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('resName').value;
            const category = document.getElementById('resCategory').value;
            const zone = document.getElementById('resZone').value;
            const time = document.getElementById('resTime').value;
            const duration = document.getElementById('resDuration').value;
            const bookingCode = 'STAYA-' + Math.floor(1000 + Math.random() * 9000);

            const modal = document.getElementById('customModal');
            const content = document.getElementById('modalContent');

            content.innerHTML = `
                <div class="text-center space-y-4">
                    <div class="w-14 h-14 rounded-2xl bg-caramel-500/20 text-caramel-600 flex items-center justify-center mx-auto text-2xl font-bold">
                        🎉
                    </div>
                    <span class="px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-700 text-xs font-extrabold uppercase">Kode Booking: ${bookingCode}</span>
                    <h3 class="text-2xl font-extrabold text-espresso-950">Reservasi Ruang Fokus Berhasil!</h3>
                    <p class="text-xs text-espresso-700">Halo <strong>${name}</strong>, tempat fokus Anda telah kami amankan:</p>
                    <div class="bg-cream-100 p-4 rounded-2xl border border-cream-300 text-left text-xs space-y-1.5">
                        <div class="flex justify-between"><span>Kategori:</span><strong>${category}</strong></div>
                        <div class="flex justify-between"><span>Zona Ruang:</span><strong>${zone}</strong></div>
                        <div class="flex justify-between"><span>Jam Kedatangan:</span><strong>${time} WIB (${duration})</strong></div>
                        <div class="flex justify-between"><span>Lokasi:</span><strong>STAYa Politeknik Astra</strong></div>
                    </div>
                    <button onclick="closeModal(); document.getElementById('reservationForm').reset();" class="w-full py-3.5 rounded-xl bg-espresso-800 hover:bg-espresso-950 text-cream-50 font-extrabold text-sm">
                        Simpan Tiket & Kembali ke Halaman
                    </button>
                </div>
            `;

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function triggerDirectChannel(channelName) {
            showToast(`Membuka saluran resmi: ${channelName}`);
        }

        function closeModal() {
            const modal = document.getElementById('customModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }
    </script>
</body>
</html>
